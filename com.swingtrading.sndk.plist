<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.swingtrading.sndk</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/2TB.ssd/_a Development/swingtrading/run_daily.sh</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/Volumes/2TB.ssd/_a Development/swingtrading</string>
    
    <!-- Run Schedule:
         - Monday 2:00 PM (14:00) EDT: Weekly Buy Signal Scan & Afternoon Execution
         - Tuesday-Thursday 2:00 PM (14:00) EDT: Portfolio Monitoring & Target/Stop Checks
         - Friday 3:30 PM (15:30) EDT: Mandatory Weekend Risk Close-Out Scan (before 16:00 Close) -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- Monday: 14:00 EDT -->
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- Tuesday: 14:00 EDT -->
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- Wednesday: 14:00 EDT -->
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- Thursday: 14:00 EDT -->
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- Friday: 15:30 EDT (Mandatory Weekend Exit Check) -->
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>
    
    <key>StandardOutPath</key>
    <string>/Volumes/2TB.ssd/_a Development/swingtrading/logs/launchd_stdout.log</string>
    
    <key>StandardErrorPath</key>
    <string>/Volumes/2TB.ssd/_a Development/swingtrading/logs/launchd_stderr.log</string>
</dict>
</plist>
