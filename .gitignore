# Git Ignore for Swing Trading Quantitative System
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Local packages and large binaries
R_libs/
.DS_Store

# Temporary log files (keep folder, ignore daily run logs)
logs/scan_*.log
logs/signal_*.log
logs/launchd_*.log

# Secrets and Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
schwab_token.json
schwab_state.json
schwab_quotes.json
orders.json
robinhood_positions.json

# Keep sample data, ignore large transient downloads
data/*.rds
data/**/*.rds
*.rds
scratch/*.rds
output/*.rds
data/cache_*/
data/data_*/
backups/*.zip
!data/data_sndk.rds

# Python cache
__pycache__/
*.pyc

# Logs
logs/*.log
output/*.log

# Regenerable price caches (scratch/build_n100_pit_universe.py, scratch/download_universe_prices.py)
data/n100_pit/prices_adjclose.csv
data/universe_prices_adjclose.csv
