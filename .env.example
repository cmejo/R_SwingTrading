# ==============================================================================
# Charles Schwab Trader API Credentials
# Obtain these from: https://developer.schwab.com
# ==============================================================================
SCHWAB_APP_KEY="your_schwab_app_key_here"
SCHWAB_SECRET="your_schwab_secret_here"
SCHWAB_REDIRECT_URI="https://127.0.0.1"

# ==============================================================================
# Robinhood Credentials (Used by execute_robinhood.py & poll_robinhood_exits.py)
# ==============================================================================
ROBINHOOD_USERNAME="your_email@domain.com"
ROBINHOOD_PASSWORD="your_robinhood_password"
ROBINHOOD_TOTP_KEY="" # Optional: Base32 authenticator key for automatic MFA generation

# ==============================================================================
# Interactive Brokers (IBKR Pro) Credentials (Used by execute_ibkr.py)
# ==============================================================================
IBKR_HOST="127.0.0.1"
IBKR_PORT="7497" # 7497 = TWS Paper, 7496 = TWS Live, 4001 = IB Gateway Live, 4002 = IB Gateway Paper
IBKR_CLIENT_ID="1"

# ==============================================================================
# Optional Push Notifications (Discord or Telegram)
# ==============================================================================
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
